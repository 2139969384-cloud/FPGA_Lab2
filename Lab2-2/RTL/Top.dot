digraph "Top" {
label="Top";
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="led0", color="black", fontcolor="black" ];
n2 [ shape=octagon, label="led1", color="black", fontcolor="black" ];
n3 [ shape=octagon, label="led2", color="black", fontcolor="black" ];
n4 [ shape=octagon, label="led3", color="black", fontcolor="black" ];
n5 [ shape=octagon, label="sys_clk", color="black", fontcolor="black" ];
n6 [ shape=octagon, label="sys_rst_n", color="black", fontcolor="black" ];
c8 [ shape=record, label="{{<p5> sys_clk|<p6> sys_rst_n}|u0\nRunning_Light|{<p7> led_out}}" ];
x0 [ shape=record, style=rounded, label="<s3> 3:3 - 0:0 |<s2> 2:2 - 0:0 |<s1> 1:1 - 0:0 |<s0> 0:0 - 0:0 " ];
c8:p7:e -> x0:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", style="setlinewidth(3)", label=""];
x0:s0:e -> n1:w [color="black", label=""];
x0:s3:e -> n2:w [color="black", label=""];
x0:s2:e -> n3:w [color="black", label=""];
x0:s1:e -> n4:w [color="black", label=""];
n5:e -> c8:p5:w [color="black", label=""];
n6:e -> c8:p6:w [color="black", label=""];
}
